#!/bin/sh
# 커밋 직전 게이트 — 이번 커밋에 올라간 SSOT 문서에 대해서만 Codex 미러를 검증한다.
#
# 대상을 스테이징된 것으로 좁히는 이유: 손대지도 않은 문서가 낡았다는 이유로
# 남의 커밋이 막히면 사람들이 --no-verify 를 습관으로 만든다. 자기가 건드린 것만 막는다.
#
# 저장소에 커밋되는 훅이라 팀 전원이 같은 것을 쓴다. 활성화는 각자 한 번:
#   git config core.hooksPath BuildTools/CI/hooks
set -e

PY=""
for c in python3 python py; do
	if command -v "$c" >/dev/null 2>&1; then
		PY="$c"
		break
	fi
done

if [ -z "$PY" ]; then
	echo "pre-commit: python 을 찾지 못했습니다. Codex 미러 문서를 검증할 수 없습니다." >&2
	echo "            python 을 설치하거나, 이번만 넘기려면 git commit --no-verify" >&2
	exit 1
fi

exec "$PY" BuildTools/CI/gen_codex_docs.py --check --staged
